[Unit]
Description=Joy Worksheet Generator (port 3101)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ws-gen
Environment=NODE_ENV=production
Environment=__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=worksheet.srv.io.vn
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
